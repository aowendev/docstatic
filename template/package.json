{
  "name": "my-site",
  "version": "0.1.0",
  "description": "A Docusaurus + TinaCMS documentation site created with docStatic.",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "dev": "tinacms dev -c \"docusaurus start\"",
    "prestart": "node scripts/generate-link-report.js",
    "start": "docusaurus start",
    "generate-media-index": "node scripts/generate-media-index.js",
    "generate-git-identity": "node scripts/generate-git-identity.js",
    "generate-files": "node scripts/generate-file-list.js",
    "generate-docs-metadata": "node scripts/generate-docs-metadata.js",
    "generate-link-report": "node scripts/generate-link-report.js",
    "check-links": "node scripts/generate-link-report.js --check",
    "update-theme-css": "node scripts/update-theme-css.js",
    "generate": "node scripts/generate-media-index.js && node scripts/generate-file-list.js && node scripts/generate-docs-metadata.js && node scripts/generate-link-report.js && node scripts/update-theme-css.js && node scripts/generate-git-identity.js",
    "prebuild": "yarn generate",
    "predev": "yarn generate",
    "prebuild-local": "yarn generate",
    "build": "tinacms build && docusaurus build",
    "build-local": "NODE_OPTIONS=--max-old-space-size=8192 tinacms build --local --skip-indexing --skip-cloud-checks && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "gen-api-docs": "docusaurus gen-api-docs all",
    "clean-api-docs": "docusaurus clean-api-docs all",
    "gen-graphql": "docusaurus docs:generate:graphql",
    "gen-api-docs:version": "docusaurus gen-api-docs:version",
    "clean-api-docs:version": "docusaurus clean-api-docs:version",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix"
  },
  "dependencies": {
    "@algolia/client-search": "^5.56.0",
    "@codemirror/language": "6.0.0",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@docusaurus/utils": "^3.10.2",
    "@docusaurus/utils-validation": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/react": "^19.2.18",
    "color": "^5.0.2",
    "docusaurus-graphql-plugin": "0.7.0",
    "docusaurus-lunr-search": "^3.6.0",
    "docusaurus-plugin-openapi-docs": "5.1.3",
    "docusaurus-plugin-sass": "^0.2.3",
    "docusaurus-theme-openapi-docs": "5.1.3",
    "dotenv": "^16.6.1",
    "fs-extra": "9.0.1",
    "image-size": "^2.0.2",
    "raw-loader": "^4.0.2",
    "react": "^19.2.8",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-loadable": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.102.0",
    "search-insights": "^2.17.3",
    "slate": "^0.118.1",
    "slate-dom": "^0.118.1",
    "sucrase": "^3.35.0",
    "tinacms": "^3.11.0",
    "title": "^4.0.1",
    "typescript": "5.6.3",
    "webpack": "^5.109.2",
    "yup": "0.32.11"
  },
  "resolutions": {
    "graphql": "15.8.0",
    "gauge": "^5.0.2",
    "mkdirp": "^1.0.4",
    "glob": "^13.0.0",
    "inflight": "npm:lru-cache@^10.0.0",
    "prebuild-install": "^7.1.3",
    "react-redux": "^9.3.0",
    "scheduler": "^0.25.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tinacms/cli": "^2.5.6",
    "deepl-node": "^1.27.0",
    "gray-matter": "^4.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
